<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true">
  <testsuites>
    <!--
      Core's only suite. The tests are owned by seatplus/web and copied in by
      `composer run browser:sync` (browser-tests.php); tests/Browser/web is
      gitignored, so an unsynced checkout finds no tests here — that is expected,
      not a misconfiguration.
    -->
    <testsuite name="Browser">
      <directory suffix="Test.php">./tests/Browser</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <!--
      Dedicated test database, aligned with the packages + all CI on `laravel`. Tests use
      RefreshDatabase (migrate:fresh), so they MUST NOT run against the dev database
      (DB_DATABASE=seatplus) or they wipe it. force="true" pins the test DB regardless of
      any DB_DATABASE env var set by the shell / dev container / CI. Create it once:
      `createdb laravel` (same host/user/password as dev); CI provides a `laravel` database
      (POSTGRES_DB: laravel in browser.yml / regression.yml). SQLite :memory: is not usable
      here — pgsql-specific migrations + the Pest browser in-process server share the connection.
    -->
    <env name="DB_DATABASE" value="laravel" force="true"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
