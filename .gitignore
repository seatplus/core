# web-owned browser tests, synced in from the package by `composer run browser`
# (browser-tests.php) and by CI — generated here, not committed.
tests/Browser/web/

# internal packages, NESTED layout (fallback) — local-dev checkouts only. The
# default is the SIBLING layout: the seatplus/* repos cloned next to core in the
# workspace. Use packages/* instead when only core is reachable (e.g. the dev
# container, which bind-mounts core alone); it takes priority over the sibling of
# the same name. Either way composer path repos + composer-merge-plugin resolve
# them into vendor/, and a plain install pulls published versions from Packagist.
/packages/

# local composer override — path repos for the discovered seatplus/* checkouts
# (sibling workspace clones, or packages/*). `composer run local:on` generates it
# and merge-plugin picks it up; `local:off` parks it as composer.local.json.off.
# Kept out of git so CI/prod resolve seatplus/* from Packagist.
/composer.local.json*
